# ==============================================================================
# AgentWindTunnel V2 — Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Application & Network
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development

# Database Settings
# Default: Local SQLite with WAL mode enabled
DATABASE_URL=sqlite:///./agent_wind_tunnel.db
# PostgreSQL Alternative:
# DATABASE_URL=postgresql://awt_user:awt_secure_pass@localhost:5432/agent_wind_tunnel
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# Worker Topology
# 1 = Start background worker inside API process (recommended for local dev)
# 0 = Run worker in a standalone process (python -m backend.worker)
AWT_EMBEDDED_WORKER=1

# Security & API Authentication
# Set AWT_REQUIRE_AUTH=1 to enforce Bearer token or X-API-Key validation
AWT_REQUIRE_AUTH=0
AWT_API_KEY=awt-dev-secret-token-change-in-production

# CORS Allowed Origins (Comma-separated list of trusted origins)
AWT_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Concurrency & Spending Controls
# Maximum simultaneous running jobs using paid upstream providers (e.g., Gemini / OpenAI)
AWT_MAX_CONCURRENT_PAID_JOBS=2

# Rate Limiting (Sliding Window)
AWT_RATE_LIMIT_GENERAL=120
AWT_RATE_LIMIT_EXECUTION=30

# Upstream LLM Provider API Keys (Optional — mock simulator requires no keys)
GEMINI_API_KEY=
OPENAI_API_KEY=
